Import('master_env')

import os.path

release = '3.0.2'
compatible = '3.0'

status = {
    'windows': 'beta-3',
    'linux': 'beta-3',
    'macosx': 'beta-3'
}

tag = '%s-%s' % (release,status[master_env['PI_PLATFORMTYPE']])
compatible_tag = '%s-%s' % (compatible,status[master_env['PI_PLATFORMTYPE']])

master_env.Prepend(CPPPATH=[master_env.Dir('.').srcnode().abspath])
master_env.Prepend(CPPPATH=[os.path.join(master_env.Dir('.').srcnode().abspath,'steinberg')])
master_env.PiRelease('release',tag,compatible_tag)

# Debian package depends on whichever python3.X EigenD actually got linked against.
python_dep = master_env.subst('$PI_PYTHON_VERSION') or 'python3'
master_env.PiPackageDescription('eigend',desc='EigenD Application',groups=('app',),depends=[python_dep])
master_env.PiPackageDescription('eigend-build',desc='EigenD Build System',groups=('bld',))
master_env.PiBuildSystem(package='eigend-build')

if master_env['IS_WINDOWS']:
    prereq = [
        ('C:\\Python314\\python.exe', 'Python 3.14 from python.org is required. Download from https://www.python.org/downloads/')
    ]

if master_env['IS_MACOSX']:
    prereq = [
        ('/Library/Frameworks/Python.framework/Versions/3.14/Python', 'Python 3.14 from python.org is required. Download from https://www.python.org/downloads/')
    ]

if master_env['IS_LINUX']:
    prereq = [
        ('/usr/bin/python3', 'Python 3.12 or newer is required. Install with: sudo apt-get install python3.14 (or 3.13/3.12)')
    ]

master_env.PiPackageCollection('EigenD-gpl',groups=('app',),prereq=prereq)
